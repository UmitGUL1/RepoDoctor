# nlohmann/json (always prefer bundled third_party/nlohmann when cross-compiling or available)
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/nlohmann/json.hpp")
    add_library(nlohmann_json INTERFACE)
    target_include_directories(nlohmann_json INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/third_party")
    add_library(nlohmann_json::nlohmann_json ALIAS nlohmann_json)
else()
    find_package(nlohmann_json 3.11 REQUIRED)
endif()

# Optional libgit2 support
if(REPODOCTOR_USE_LIBGIT2 AND NOT CMAKE_CROSSCOMPILING)
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(LIBGIT2 QUIET IMPORTED_TARGET libgit2)
    endif()
    if(LIBGIT2_FOUND)
        message(STATUS "RepoDoctor: Found libgit2 (${LIBGIT2_VERSION})")
    else()
        message(STATUS "RepoDoctor: libgit2 not found, using standard filesystem Git inspector")
        set(REPODOCTOR_USE_LIBGIT2 OFF CACHE BOOL "Use libgit2" FORCE)
    endif()
endif()

# GoogleTest for unit and integration testing
if(REPODOCTOR_BUILD_TESTS AND NOT CMAKE_CROSSCOMPILING)
    find_package(GTest QUIET)
    if(NOT GTest_FOUND)
        message(STATUS "RepoDoctor: GTest not found; disabling tests for this target toolchain")
        set(REPODOCTOR_BUILD_TESTS OFF CACHE BOOL "Build tests" FORCE)
    endif()
endif()

# Qt6 for desktop GUI
if(REPODOCTOR_BUILD_GUI AND NOT CMAKE_CROSSCOMPILING)
    find_package(Qt6 COMPONENTS Core Gui Qml Quick QuickControls2 Widgets QUIET)
    if(NOT Qt6_FOUND)
        message(STATUS "RepoDoctor: Qt6 not found; disabling GUI build for this preset")
        set(REPODOCTOR_BUILD_GUI OFF CACHE BOOL "Build GUI" FORCE)
    else()
        message(STATUS "RepoDoctor: Found Qt6 (${Qt6_VERSION})")
    endif()
endif()
